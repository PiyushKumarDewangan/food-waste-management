# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — must match your Vite frontend dev server exactly
CORS_ORIGIN=http://localhost:5173

# Used to build links inside emails (password reset, approval notices, etc).
# Usually the same as CORS_ORIGIN in dev.
FRONTEND_URL=http://localhost:5173

# Cookies
REFRESH_COOKIE_NAME=fb_refresh_token

# File uploads
MAX_UPLOAD_SIZE_MB=5

# Google OAuth (used later by authController.googleLogin)
GOOGLE_CLIENT_ID=your_google_client_id

# SMTP (password reset emails, approval notices, etc.)
# If left blank, emails are logged to the console instead of sent — useful
# for local development without a real mail provider.
#
# Example using Gmail:
#   1. Enable 2-Step Verification on the Google account
#   2. Create an "App Password" at https://myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
#
# Any other SMTP provider (SendGrid, Mailgun, Amazon SES, Resend's SMTP, Mailtrap for testing) works the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FoodBridge" <no-reply@foodbridge.org>
