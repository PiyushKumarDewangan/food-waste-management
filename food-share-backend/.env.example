# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — must match your Vite frontend dev server exactly
CORS_ORIGIN=http://localhost:5173

# Cookies
REFRESH_COOKIE_NAME=fb_refresh_token

# File uploads
MAX_UPLOAD_SIZE_MB=5

# Google OAuth (used later by authController.googleLogin)
GOOGLE_CLIENT_ID=your_google_client_id
